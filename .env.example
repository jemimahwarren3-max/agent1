# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database / cache ---
DATABASE_URL=postgresql://haki:haki@localhost:5432/haki_prospecting
REDIS_URL=redis://localhost:6379/0

# --- Gemini / Google ADK ---
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Google OAuth (Gmail, Sheets, Drive) ---
# Create an OAuth client in Google Cloud Console > APIs & Services > Credentials.
# Enable: Gmail API, Google Sheets API, Google Drive API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Key used to encrypt OAuth refresh/access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Search provider for lead discovery ---
# Create a Programmable Search Engine at https://programmablesearchengine.google.com/
SEARCH_PROVIDER=google_cse
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
